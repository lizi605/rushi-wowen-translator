# ============================================================
# 佛说翻译器 · 模型接口配置（OpenAI 兼容 /chat/completions）
# 只需 3 个变量：API Key、接口地址、模型名。
# 复制本文件为 .env.local 并填入你的值。
# ============================================================

# 【必填】API Key（只放在服务端，切勿提交到仓库）
DEEPSEEK_API_KEY=sk-your-key-here

# 【接口地址】默认 DeepSeek 官方；换平台改这里（结尾不要带 /chat/completions）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【模型名】跟随所选平台
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：译经初稿后的事实审校模型。建议使用能力更强的型号。
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro

# 可选：公开部署时用于控制单次输出上限
MAX_OUTPUT_TOKENS=2400

# ------------------------------------------------------------
# 各免费 / 低价平台参考：把上面 3 个变量换成下面任意一组即可
# ------------------------------------------------------------
#
# ★ 智谱 GLM（永久免费 · 国内直连 · 中文强 · 推荐）
#   DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   DEEPSEEK_MODEL=glm-4.7-flash
#
# ★ 阿里百炼 通义千问（新用户送 7000 万 token / 90 天 · 中文极强）
#   DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   DEEPSEEK_MODEL=qwen-plus
#
# 硅基流动 SiliconFlow（送 ¥14 · 聚合多模型）
#   DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
#   DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3
#
# Google Gemini（免费约 1500 次/天 · 需科学上网）
#   DEEPSEEK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   DEEPSEEK_MODEL=gemini-2.5-flash
#
# OpenRouter（聚合平台 · 含部分免费模型）
#   DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
#   DEEPSEEK_MODEL=deepseek/deepseek-chat
